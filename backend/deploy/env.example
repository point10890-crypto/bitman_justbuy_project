# ============================================================================
# /etc/justbuy/env — prod 환경변수 템플릿
# ============================================================================
# 배포 절차:
#   sudo mkdir -p /etc/justbuy
#   sudo cp env.example /etc/justbuy/env
#   sudo chown root:justbuy /etc/justbuy/env
#   sudo chmod 640 /etc/justbuy/env
#   sudo vim /etc/justbuy/env   # 실키로 교체
# ============================================================================

# ─── Spring 프로파일 ─────────────────────────────────────────
SPRING_PROFILES_ACTIVE=prod

# ─── 필수: JWT ──────────────────────────────────────────────
# 생성: openssl rand -base64 64
JWT_SECRET=__REPLACE_WITH_openssl_rand_-base64_64__

# ─── 필수: 관리자 계정 ───────────────────────────────────────
ADMIN_EMAIL=your-admin@example.com
# 최초 1회만 필요. 12자+대소문자+숫자+특수문자.
# 계정 생성 후 반드시 웹 UI에서 변경하고 이 줄 삭제.
ADMIN_DEFAULT_PASSWORD=__CHANGE_ON_FIRST_LOGIN_12CHARS_MIXED__

# ─── 필수: AI API 키 ────────────────────────────────────────
OPENAI_API_KEY=sk-...
XAI_API_KEY=xai-...
ANTHROPIC_API_KEY=sk-ant-...
GOOGLE_API_KEY=...
PERPLEXITY_API_KEY=pplx-...

# ─── 필수: 시장 데이터 API ──────────────────────────────────
DART_API_KEY=...
BITMAN_KIS_APP_KEY=...
BITMAN_KIS_APP_SECRET=...

# ─── 선택: 텔레그램 알림 ────────────────────────────────────
TELEGRAM_BOT_TOKEN=...
TELEGRAM_CHAT_ID=...
TELEGRAM_CHANNEL_CHAT_ID=...

# ─── 선택: DB override (기본 H2 파일) ───────────────────────
# PostgreSQL 이전 시:
# SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/justbuy
# SPRING_DATASOURCE_USERNAME=justbuy
# SPRING_DATASOURCE_PASSWORD=__CHANGE_ME__

# ─── 선택: CORS 도메인 추가 ────────────────────────────────
# 기본값: https://bitman-justbuy.pages.dev,https://api.bit-man.net
# CORS_ORIGINS=https://bitman-justbuy.pages.dev,https://api.bit-man.net,https://extra.domain

# ─── 선택: 스케줄러 ───────────────────────────────────────
SCHEDULER_ENABLED=true
