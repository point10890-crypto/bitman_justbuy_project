<?xml version="1.0" encoding="UTF-8"?>
<!--
  BitMan JustBuy — Logback 롤링 정책
  - dev: 콘솔만
  - prod: 콘솔 + 일별 롤링 파일 (30일 보관 / 총 3GB 제한)
-->
<configuration>

    <property name="CONSOLE_PATTERN" value="%d{yyyy-MM-dd HH:mm:ss.SSS} [%thread] %-5level %logger{40} - %msg%n"/>
    <property name="FILE_PATTERN"    value="%d{yyyy-MM-dd HH:mm:ss.SSS} [%thread] %-5level %logger{40} - %msg%n"/>

    <!-- ========================= 콘솔 (공통) ========================= -->
    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>${CONSOLE_PATTERN}</pattern>
            <charset>UTF-8</charset>
        </encoder>
    </appender>

    <!-- ========================= dev 프로파일 ========================= -->
    <springProfile name="dev">
        <root level="INFO">
            <appender-ref ref="CONSOLE"/>
        </root>
        <logger name="com.bitman.justbuy" level="DEBUG"/>
    </springProfile>

    <!-- ========================= prod 프로파일 ========================= -->
    <springProfile name="prod">
        <!-- LOG_PATH 기본값: /var/log/justbuy.
             application-prod.yml 의 logging.file.path 가 주입되며, 환경변수 override 가능. -->
        <property name="LOG_PATH" value="${LOG_PATH:-/var/log/justbuy}"/>

        <appender name="FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
            <file>${LOG_PATH}/justbuy.log</file>
            <encoder>
                <pattern>${FILE_PATTERN}</pattern>
                <charset>UTF-8</charset>
            </encoder>
            <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
                <fileNamePattern>${LOG_PATH}/archive/justbuy-%d{yyyy-MM-dd}.%i.log.gz</fileNamePattern>
                <!-- 개별 파일 100MB 도달 시 롤링 -->
                <maxFileSize>100MB</maxFileSize>
                <!-- 30일 보관 -->
                <maxHistory>30</maxHistory>
                <!-- 아카이브 전체 3GB 상한 (Oracle Cloud Free 50GB 디스크 보호) -->
                <totalSizeCap>3GB</totalSizeCap>
            </rollingPolicy>
        </appender>

        <!-- ERROR 전용 별도 파일 (장애 추적 편의) -->
        <appender name="ERROR_FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
            <file>${LOG_PATH}/justbuy-error.log</file>
            <filter class="ch.qos.logback.classic.filter.ThresholdFilter">
                <level>ERROR</level>
            </filter>
            <encoder>
                <pattern>${FILE_PATTERN}</pattern>
                <charset>UTF-8</charset>
            </encoder>
            <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
                <fileNamePattern>${LOG_PATH}/archive/justbuy-error-%d{yyyy-MM-dd}.%i.log.gz</fileNamePattern>
                <maxFileSize>50MB</maxFileSize>
                <maxHistory>60</maxHistory>
                <totalSizeCap>1GB</totalSizeCap>
            </rollingPolicy>
        </appender>

        <root level="INFO">
            <appender-ref ref="CONSOLE"/>
            <appender-ref ref="FILE"/>
            <appender-ref ref="ERROR_FILE"/>
        </root>

        <logger name="com.bitman.justbuy" level="INFO"/>
        <logger name="org.springframework.security" level="WARN"/>
        <logger name="org.hibernate.SQL" level="WARN"/>
    </springProfile>

    <!-- ========================= 프로파일 미지정 fallback ========================= -->
    <springProfile name="!dev &amp; !prod">
        <root level="INFO">
            <appender-ref ref="CONSOLE"/>
        </root>
    </springProfile>

</configuration>
